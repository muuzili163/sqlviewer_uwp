<UserControl
    x:Class="SQLViewerWinUI3.Views.SqlEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top toolbar -->
        <Grid Grid.Row="0" Padding="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Database ComboBox -->
            <ComboBox x:Name="comboBox1" 
                      Grid.Column="0"
                      FontSize="16"
                      PlaceholderText="选择数据库"
                      SelectionChanged="ComboBox1_SelectedIndexChanged"/>

            <!-- Table ComboBox -->
            <ComboBox x:Name="comboBox2" 
                      Grid.Column="1"
                      FontSize="16"
                      Margin="8,0"
                      PlaceholderText="选择表"
                      SelectionChanged="ComboBox2_SelectedIndexChanged"/>

            <!-- Query Button -->
            <Button x:Name="button1" 
                    Grid.Column="2"
                    Content="查询" 
                    Click="Button1_Click"/>
        </Grid>

        <!-- Main content area with split view -->
        <Grid Grid.Row="1" Padding="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="200" MinHeight="100"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="200"/>
            </Grid.RowDefinitions>

            <!-- SQL Editor area -->
            <Grid Grid.Row="0">
                <RichEditBox x:Name="richTextBox1" 
                            FontSize="16"
                            FontFamily="Consolas"
                            AcceptsReturn="True"
                            TextWrapping="NoWrap"/>
                
                <ListView x:Name="listBoxSuggest" 
                          FontSize="16"
                          MaxHeight="200"
                          Visibility="Collapsed"
                          SelectionChanged="ListBoxSuggest_SelectionChanged"
                          ItemClick="ListBoxSuggest_ItemClick"
                          IsItemClickEnabled="True"/>
            </Grid>

            <!-- Splitter -->
            <Grid Grid.Row="1" Height="8" Background="Transparent"/>

            <!-- Results DataGrid area -->
            <ScrollViewer Grid.Row="2" x:Name="scrollViewer1">
                <Grid x:Name="dataGridContainer">
                    <!-- DataGrid will be created dynamically -->
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Bottom status bar -->
        <Grid Grid.Row="2" Padding="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Spacer -->
            <Grid Grid.Column="0"/>

            <!-- Rows Count Label -->
            <TextBlock x:Name="label3" 
                       Grid.Column="1"
                       Text="条数"
                       Margin="8,0"
                       VerticalAlignment="Center"/>

            <!-- Query Time Label -->
            <TextBlock x:Name="label2" 
                       Grid.Column="2"
                       Text="查询时间"
                       Margin="8,0"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
