<UserControl
    x:Class="SQLViewerWinUI3.Views.TableViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top toolbar -->
        <Grid Grid.Row="0" Padding="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Table Structure Button -->
            <Button x:Name="button2" 
                    Grid.Column="0"
                    Content="表结构" 
                    Click="Button2_Click"/>

            <!-- Query TextBox with AutoSuggest -->
            <Grid Grid.Column="1" Margin="8,0">
                <TextBox x:Name="textBox1" 
                         FontSize="16"
                         PlaceholderText="输入查询条件"
                         KeyDown="TextBox1_KeyDown"
                         TextChanged="TextBox1_TextChanged"/>
                
                <ListView x:Name="listBoxSuggest" 
                          FontSize="16"
                          Margin="0,40,0,0"
                          MaxHeight="200"
                          Visibility="Collapsed"
                          SelectionChanged="ListBoxSuggest_SelectionChanged"
                          ItemClick="ListBoxSuggest_ItemClick"
                          IsItemClickEnabled="True"/>
            </Grid>

            <!-- Query Button -->
            <Button x:Name="button3" 
                    Grid.Column="2"
                    Content="查询" 
                    Margin="0,0,8,0"
                    Click="Button3_Click"/>

            <!-- Clear Sort Button -->
            <Button x:Name="button4" 
                    Grid.Column="3"
                    Content="清空排序" 
                    Margin="0,0,8,0"
                    Click="Button4_Click"/>

            <!-- Copy SQL Button -->
            <Button x:Name="button6" 
                    Grid.Column="4"
                    Content="复制SQL" 
                    Click="Button6_Click"/>
        </Grid>

        <!-- Main content area -->
        <Grid Grid.Row="1" Padding="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Rich TextBox for table structure (collapsible) -->
            <RichEditBox x:Name="richTextBox1" 
                        Grid.Row="0"
                        FontSize="16"
                        IsReadOnly="True"
                        Visibility="Collapsed"/>

            <!-- DataGrid -->
            <ScrollViewer Grid.Row="0" x:Name="scrollViewer1">
                <Grid x:Name="dataGridContainer">
                    <!-- DataGrid will be created dynamically -->
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Bottom status bar -->
        <Grid Grid.Row="2" Padding="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- SQL Query Label -->
            <TextBlock x:Name="label1" 
                       Grid.Column="0"
                       Text="查询"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>

            <!-- Server Label -->
            <TextBlock x:Name="label5" 
                       Grid.Column="1"
                       Text="服务:"
                       Margin="8,0"
                       VerticalAlignment="Center"/>

            <!-- Count Total Button and Label -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="button5" 
                        Content="计算总数" 
                        Click="Button5_Click"/>
                <TextBlock x:Name="label4" 
                           Text="总数"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Rows Count Label -->
            <TextBlock x:Name="label3" 
                       Grid.Column="3"
                       Text="条数"
                       Margin="8,0"
                       VerticalAlignment="Center"/>

            <!-- Query Time Label -->
            <TextBlock x:Name="label2" 
                       Grid.Column="4"
                       Text="查询时间"
                       Margin="8,0"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
