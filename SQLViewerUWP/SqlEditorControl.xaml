<UserControl x:Class="SQLViewerUWP.SqlEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top toolbar -->
        <Grid Grid.Row="0" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0" x:Name="CbDatabase" Width="180" Height="30" 
                      FontSize="12" SelectionChanged="CbDatabase_SelectionChanged"/>

            <ComboBox Grid.Column="1" x:Name="CbTable" Width="180" Height="30" 
                      FontSize="12" Margin="10,0,0,0"
                      SelectionChanged="CbTable_SelectionChanged"/>

            <Button Grid.Column="2" x:Name="BtnExecute" Content="查询" 
                    Width="100" Height="30" Margin="10,0,0,0"
                    Click="BtnExecute_Click"/>
        </Grid>

        <!-- Splitter between editor and results -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="200" MinHeight="100"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="*" MinHeight="100"/>
            </Grid.RowDefinitions>

            <!-- SQL Editor -->
            <Grid Grid.Row="0">
                <TextBox x:Name="TxtSqlEditor" 
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         FontFamily="Consolas"
                         FontSize="12"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextChanged="TxtSqlEditor_TextChanged"
                         KeyDown="TxtSqlEditor_KeyDown"/>
                
                <ListBox x:Name="LstSqlSuggestions" 
                         Height="150" MaxWidth="300"
                         Visibility="Collapsed"
                         VerticalAlignment="Top"
                         HorizontalAlignment="Left"
                         DisplayMemberPath="Text"
                         MouseDoubleClick="LstSqlSuggestions_MouseDoubleClick"
                         KeyDown="LstSqlSuggestions_KeyDown"/>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" 
                          Background="#E0E0E0"/>

            <!-- Results area -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Info panel -->
                <Grid Grid.Row="0" Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" x:Name="LblQueryTime" Text="查询时间：" 
                               FontSize="11" VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1" x:Name="LblCount" Text="条数：" 
                               FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </Grid>

                <!-- DataGrid -->
                <DataGrid Grid.Row="1" x:Name="DgResults" 
                          AutoGenerateColumns="True"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          FontSize="12"
                          RowHeight="30"
                          ColumnHeaderHeight="36"
                          SelectionMode="Extended"
                          SelectionUnit="Cell"
                          Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
