<Window x:Class="SQLViewerUWP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SQLViewerUWP"
        mc:Ignorable="d"
        Title="Archery互联网SQL审计" Height="900" Width="1400"
        WindowState="Maximized"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top toolbar -->
        <Grid Grid.Row="0" Background="#F0F0F0" Margin="10,5,10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0" x:Name="CbServer" Width="200" Height="35" 
                      FontSize="14" Margin="5,0,0,0"
                      SelectionChanged="CbServer_SelectionChanged"/>

            <Button Grid.Column="2" x:Name="BtnNewQuery" Content="新建查询" 
                    Width="120" Height="35" Margin="5,0,0,0"
                    Click="BtnNewQuery_Click"/>

            <ComboBox Grid.Column="3" x:Name="CbPageSize" Width="130" Height="35" 
                      FontSize="14" Margin="10,0,0,0"
                      SelectionChanged="CbPageSize_SelectionChanged">
                <ComboBoxItem>50</ComboBoxItem>
                <ComboBoxItem IsSelected="True">100</ComboBoxItem>
                <ComboBoxItem>200</ComboBoxItem>
                <ComboBoxItem>500</ComboBoxItem>
                <ComboBoxItem>1000</ComboBoxItem>
            </ComboBox>

            <Button Grid.Column="4" x:Name="BtnLogin" Content="登录" 
                    Width="170" Height="35" Margin="10,0,5,0"
                    Click="BtnLogin_Click"/>
        </Grid>

        <!-- Main content area with splitter -->
        <Grid Grid.Row="1" Margin="10,5,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="150"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left panel - TreeView -->
            <TreeView Grid.Column="0" x:Name="TvDatabases" FontSize="14"
                      MouseDoubleClick="TvDatabases_MouseDoubleClick">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <EventSetter Event="Expanded" Handler="TreeViewItem_Expanded"/>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" 
                          Background="#E0E0E0"/>

            <!-- Right panel - TabControl -->
            <TabControl Grid.Column="2" x:Name="TabMain" FontSize="12">
                <!-- Tabs will be added dynamically -->
            </TabControl>
        </Grid>
    </Grid>
</Window>
